{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:static": "tsx scripts/generate-static-site.ts",
    "build:full": "vite build && npm run build:static",
    "migrate:seo": "tsx scripts/migrate-to-seo-urls.ts",
    "migrate:seo:dry-run": "tsx scripts/migrate-to-seo-urls.ts --dry-run",
    "migrate:seo:monitor": "tsx scripts/monitor-migration.ts",
    "preview": "vite preview",
    "preview:static": "npm run build:full && vite preview",
    "dev:functions": "wrangler pages dev dist --compatibility-date=2026-08-12",
    "backend": "tsx backend.ts",
    "dev:backend": "tsx watch backend.ts",
    "dev:api": "tsx watch backend.ts",
    "email:dev": "email dev --dir emails",
    "email:preview": "tsx scripts/preview-newsletter-email.ts",
    "newsletter:send": "tsx scripts/send-newsletter-issue.ts",
    "db:setup": "node -e \"const {execSync} = require('child_process'); const url = process.env.DATABASE_URL || 'postgresql://localhost/heatcheck'; execSync(`psql '${url}' -f schema.sql`, {stdio: 'inherit'})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/genai": "^1.34.0",
    "@neondatabase/serverless": "^1.1.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "openai": "^6.15.0",
    "pg": "^8.16.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "satori-legacy": "npm:satori@^0.10.9",
    "xlsx": "^0.18.5",
    "yoga-wasm-web": "^0.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "react-email": "^6.9.2",
    "satori": "^0.33.4",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.122.0"
  }
}
